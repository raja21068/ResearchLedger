\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Support-set semantics: one claim $C$ with sufficient sets $S_1=\{E_1,E_2\}$ and $S_2=\{E_3\}$, a necessary premise $P$, a non-epistemic dependency $Q$ and a manuscript assertion $A$, under four revisions. (a) Losing $E_1$ breaks $S_1$ but $S_2$ survives. (b) Losing $E_1$ and $E_3$ leaves no sufficient set. (c) Losing $P$ stales $C$ although both sets are intact. (d) Losing $Q$ stales $C$ without $Q$ ever counting as support. Under binary edges only outcome (a) is reproduced; in (b)--(d) $C$ and $A$ would be left unchanged.}}{7}{figure.caption.5}\protected@file@percent }
\newlabel{fig:support}{{2}{7}{Support-set semantics: one claim $C$ with sufficient sets $S_1=\{E_1,E_2\}$ and $S_2=\{E_3\}$, a necessary premise $P$, a non-epistemic dependency $Q$ and a manuscript assertion $A$, under four revisions. (a) Losing $E_1$ breaks $S_1$ but $S_2$ survives. (b) Losing $E_1$ and $E_3$ leaves no sufficient set. (c) Losing $P$ stales $C$ although both sets are intact. (d) Losing $Q$ stales $C$ without $Q$ ever counting as support. Under binary edges only outcome (a) is reproduced; in (b)--(d) $C$ and $A$ would be left unchanged}{figure.caption.5}{}}
\newlabel{fig:support@cref}{{[figure][2][]2}{[1][7][]7}{}{}{}}
