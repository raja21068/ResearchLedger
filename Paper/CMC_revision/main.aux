\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces TRL architecture. Pipeline stages register typed relations among runs, evidence, claims, decisions and manuscript assertions. A revision event enters the transaction manager, which applies it to a private copy, propagates it through the lineage closure, checks invariants $I_1$--$I_8$, and either commits a content-addressed, hash-chained snapshot or rolls back. The export gate admits a manuscript only if every assertion is ledger-admissible under the registered graph.}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:framework}{{1}{2}{TRL architecture. Pipeline stages register typed relations among runs, evidence, claims, decisions and manuscript assertions. A revision event enters the transaction manager, which applies it to a private copy, propagates it through the lineage closure, checks invariants $I_1$--$I_8$, and either commits a content-addressed, hash-chained snapshot or rolls back. The export gate admits a manuscript only if every assertion is ledger-admissible under the registered graph}{figure.caption.1}{}}
\newlabel{fig:framework@cref}{{[figure][1][]1}{[1][2][]2}{}{}{}}
