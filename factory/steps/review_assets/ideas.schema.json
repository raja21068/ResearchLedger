        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "hypothesis": {"type": "string"},
          "method": {"type": "string"},
          "falsifier": {
            "type": "object",
            "required": ["statement", "metric", "threshold"],
            "properties": {
              "statement": {"type": "string"},
              "metric": {"type": "string"},
