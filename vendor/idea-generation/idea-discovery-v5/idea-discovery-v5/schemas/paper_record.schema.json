{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["paper_id", "title", "authors", "year", "problem", "method", "claims", "limitations", "reproducibility", "extraction_confidence"],
  "properties": {
    "paper_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "authors": {"type": "array", "items": {"type": "string"}},
    "year": {"type": ["integer", "null"], "minimum": 1800, "maximum": 2100},
    "venue": {"type": ["string", "null"]},
    "doi": {"type": ["string", "null"]},
    "arxiv_id": {"type": ["string", "null"]},
    "problem": {"type": "object", "required": ["statement"], "properties": {"statement": {"type": ["string", "null"]}}},
    "method": {"type": "object", "required": ["name", "category", "mechanism"], "properties": {"name": {"type": ["string", "null"]}, "category": {"type": ["string", "null"]}, "mechanism": {"type": ["string", "null"]}}},
    "datasets": {"type": "array"},
    "metrics": {"type": "array"},
    "claims": {"type": "array"},
    "limitations": {"type": "object", "required": ["acknowledged", "inferred"], "properties": {"acknowledged": {"type": "array"}, "inferred": {"type": "array", "minItems": 1}}},
    "reproducibility": {"type": "object"},
    "extraction_confidence": {"enum": ["high", "medium", "low"]}
  },
  "additionalProperties": true
}
