{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["gaps"],
  "properties": {
    "gaps": {"type": "array", "items": {"type": "object", "required": ["gap_id", "type", "title", "description", "evidence", "scoring"], "properties": {
      "gap_id": {"type": "string"},
      "type": {"enum": ["VOID", "CONFLICT", "WEAKNESS", "ASSUMPTION", "FUTURE_WORK"]},
      "title": {"type": "string"},
      "description": {"type": "string"},
      "evidence": {"type": "object"},
      "scoring": {"type": "object", "required": ["impact", "feasibility", "novelty", "priority_score"], "properties": {
        "impact": {"type": "integer", "minimum": 1, "maximum": 3}, "feasibility": {"type": "integer", "minimum": 1, "maximum": 3}, "novelty": {"type": "integer", "minimum": 1, "maximum": 3}, "priority_score": {"type": "integer", "minimum": 1, "maximum": 27}
      }}
    }}}
  },
  "additionalProperties": true
}
