{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Executed MVE Evidence",
  "type": "object",
  "required": ["idea_id", "executed", "results", "artifacts"],
  "properties": {
    "idea_id": {"type": "string", "minLength": 1},
    "executed": {"const": true},
    "protocol_version": {"type": "string"},
    "executed_at": {"type": "string"},
    "environment": {"type": ["object", "string"]},
    "results": {"type": ["object", "array"], "minProperties": 1},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": ["string", "object"]}},
    "controls": {"type": ["object", "array"]},
    "leakage_checks": {"type": ["object", "array"]},
    "uncertainty": {"type": ["object", "string"]},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
